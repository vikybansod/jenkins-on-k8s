@Library('jenkins-shared-lib') _

pipeline {

    agent {
        kubernetes {
            label 'infra-agent'
            defaultContainer 'infra'
            workspaceVolume emptyDirWorkspaceVolume()
        }
    }

    environment {
        ENV = 'uat'
    }

    stages {

        stage('Load Config from Library') {
            steps {
                container('infra') {
                    script {
                        def cfg = envConfig(env.ENV)

                        cfg.each { k, v ->
                            env."${k}" = v
                        }

                        echo "Loaded config for ${env.ENV}"
                    }
                }
            }
        }

        stage('Validate Env Vars') {
            steps {
                container('infra') {
                    sh '''
                        echo "AWS_REGION=$AWS_REGION"
                        echo "CLUSTER=$CLUSTER"
                    '''
                }
            }
        }

        stage('Use Library Function') {
            steps {
                container('infra') {
                    script {
                        common.sayHello("Viky")
                    }
                }
            }
        }
    }

    post {
        always {
            deleteDir()
        }
    }
}